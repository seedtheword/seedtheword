# Editor / IDE metadata — local only
.kiro/
.vscode/
.idea/
*.code-workspace

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Backup files
*.bak
*.orig
*~

# Logs
*.log

# Dependency artifacts (if we ever add a build step)
node_modules/
__pycache__/
*.pyc

# Large local-only video files (host these on Drive / YouTube and embed
# instead — anything over a few MB shouldn't be committed).
assets/videos/*.mp4

# Personal documents — never commit
inv-id.JPG

# Temporary git command output files (created by tooling — never commit)
git-out.txt
git-err.txt
push-out.txt
push-out2.txt
push-err.txt
push-output.txt
push-result.txt
push-stdout.txt
push-stderr.txt
pull-out.txt
pull-err.txt
pull-result.txt
pull-stdout.txt
pull-stderr.txt
status.txt
commitmsg.txt
gp*.txt
pp.txt
pr.txt
pr2.txt

# Local backup files
community.html.backup

