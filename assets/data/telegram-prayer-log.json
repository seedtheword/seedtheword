    {
      "chatId": -1003502632009,
      "messageId": 5188,
      "userId": 5309134293,
      "displayName": "David",
      "anonymous": false,
      "kind": "telegram",
      "text": "Please pray for my friend Misha, apparently he was involved in a house fire on vacation or something I believe and he managed to get out alive. But as you can see in the video the whole entire house burned down",
      "ts": "2026-08-07T20:34:25Z"
    },
    {
      "chatId": -1003502632009,
      "messageId": 5201,
      "userId": 8045440327,
      "displayName": "✝️🙏PRAYER DOG🐺🥀",
      "anonymous": false,
      "kind": "telegram",
      "text": "Prayer for Tony, as I was waiting at the bus stop, I met a man who seemed homeless, but hes a really chill nice guy, and believer of Christ. He was heading to church, and we just talked at the stop, and so I asked him, is there anything I can pray over him over. Because when two or more believers agree on something it will be done for them and when two or more believers are gathered Jesus is with us also... and so he asked for prayers for an upcoming hernia operation. I prayed over him, layed hands, and blessed him, and his upcoming operations. I also ask you pray for him. Pray for Tony Guys, really cool dude, and I really want him to get better!!!",
      "ts": "2026-08-09T15:19:57Z"
    },
    {
      "chatId": -1003502632009,
      "messageId": 5202,
      "userId": 5309134293,
      "displayName": "David",
      "anonymous": false,
      "kind": "telegram",
